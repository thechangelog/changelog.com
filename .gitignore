# App artifacts
/_build
/db
/deps
/*.ez
.DS_Store
/.elixir_ls
# Track shared skills under .claude; ignore only local Claude settings.
# NB: an explicit file ignore, NOT `/.claude/*` + `!/.claude/skills/` — rsync's
# gitignore filter in `mise vm:keep` doesn't honor git's `!` re-include, so a
# negation silently drops .claude/skills from the host sync.
/.claude/settings.local.json

# Generate on crash by the VM
erl_crash.dump

# Static artifacts
/assets/node_modules
/assets/app/deprecated

# npm logs
npm-debug.log*

# Since we are building assets,
# we ignore priv/static. You may want to comment
# this depending on your deployment strategy.
/priv/static/

# generate this using `mix phx.gen.cert localhost dev.changelog.com`
# for each dev environment
/priv/cert/

# Legacy assets which are built into thechangelog/proxy image
/nginx/www/wp-content

# The config/prod.secret.exs file by default contains sensitive
# data and you should not commit it into version control.
#
# Alternatively, you may comment the line below and commit the
# secrets file as long as you replace its contents by environment
# variables.
/config/prod.secret.exs
/priv/uploads
/priv/db
/import/cookies.yml
/cover

# User-specific environment variables
.env.user
# Secret variables (legacy)
.envrc.secrets

# mise local state
mise.local.toml

# Local config files, host-specific
.config

# Postgres DB dump
/db-*
*.sql

# Temporary directory for files that should not be tracked by git
/tmp
