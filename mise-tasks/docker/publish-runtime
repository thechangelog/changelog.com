#!/usr/bin/env bash
#MISE description="Publish runtime image to ghcr.io"
set -euo pipefail

source tmp/mise-runtime-image.env

GHCR_USERNAME="${GHCR_USERNAME:?must be set}"
GHCR_PASSWORD="${GHCR_PASSWORD:?must be set}"

echo "${GHCR_PASSWORD}" | docker login ghcr.io -u "${GHCR_USERNAME}" --password-stdin
docker push "${RUNTIME_IMAGE}"
echo "✓ Published ${RUNTIME_IMAGE}"
