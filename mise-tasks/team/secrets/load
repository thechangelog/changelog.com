#!/usr/bin/env bash
#MISE description="Enable fnox-env secrets via mise.local.toml"
set -euo pipefail
[ -z "${DEBUG:-}" ] || set -x

if ! op whoami &>/dev/null
then
  echo "❌ Not signed in to 1Password"
  echo ""
  echo "First time? Add your account:"
  echo ""
  echo "  op account add"
  echo ""
  echo "Then sign in:"
  echo ""
  echo '  eval $(op signin)'
  echo ""
  exit 1
fi

PLUGIN='fnox-env = "https://github.com/jdx/mise-env-fnox"'
FNOX_ENV='_.fnox-env = { tools = true, profile = "dev" }'

if [ -f mise.local.toml ] && grep -q '_.fnox-env' mise.local.toml
then
  echo "✅ fnox-env already enabled in mise.local.toml"
  exit 0
fi

if [ -f mise.local.toml ] && grep -q '^\[plugins\]' mise.local.toml
then
  sed -i "/^\[plugins\]/a ${PLUGIN}" mise.local.toml
else
  printf '[plugins]\n%s\n' "${PLUGIN}" >> mise.local.toml
fi

if grep -q '^\[env\]' mise.local.toml
then
  sed -i "/^\[env\]/a ${FNOX_ENV}" mise.local.toml
else
  printf '\n[env]\n%s\n' "${FNOX_ENV}" >> mise.local.toml
fi

echo "✅ fnox-env enabled — signed in as $(op whoami 2>/dev/null | awk '/Email:/{print $2}'), secrets will load from 1Password"
