#!/usr/bin/env bash
#MISE description="Publish production container image"
set -euo pipefail
[ -z "${DEBUG:-}" ] || set -x
source "${MISE_PROJECT_ROOT}/mise-tasks/team/_lib.sh"

require_env_file tmp/mise-prod-image.env "mise docker:build-prod"
require_env GHCR_USERNAME GHCR_PASSWORD

echo "${GHCR_PASSWORD}" | docker login ghcr.io -u "${GHCR_USERNAME}" --password-stdin
docker push "${PROD_IMAGE}"

DESCRIPTION=$(docker inspect "${PROD_IMAGE}" --format '{{index .Config.Labels "org.opencontainers.image.description"}}')
SOURCE=$(docker inspect "${PROD_IMAGE}" --format '{{index .Config.Labels "org.opencontainers.image.source"}}')
REVISION=$(docker inspect "${PROD_IMAGE}" --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')
docker buildx imagetools create \
  --annotation "index:org.opencontainers.image.description=${DESCRIPTION}" \
  --annotation "index:org.opencontainers.image.source=${SOURCE}" \
  --annotation "index:org.opencontainers.image.revision=${REVISION}" \
  --tag "${PROD_IMAGE}" \
  "${PROD_IMAGE}"

echo "✅ Published ${PROD_IMAGE}"
