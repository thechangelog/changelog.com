#!/usr/bin/env bash
#MISE description="Run app in dev mode connected to a prod db branch"
#MISE raw=true
#MISE depends=["deps:get"]
#USAGE arg "<branch>" help="The Neon branch name to connect to"
set -euo pipefail
[ -z "${DEBUG:-}" ] || set -x

if [[ "$(uname)" == "Linux" ]]
then
  export ELIXIR_ERL_OPTIONS="+fnu"
  export HOST="${HOST:-$(hostname -I | awk '{print $1}')}"
  export DB_CACERTFILE="/etc/ssl/certs/ca-certificates.crt"
fi

source "${MISE_PROJECT_ROOT}/mise-tasks/team/_lib.sh"
require_env NEON_PROJECT_ID DB_PROD_USERNAME DB_PROD_DBNAME

BRANCH="${usage_branch}"

# Get connection details and convert to env vars. Capture the YAML once and
# extract each field with awk into command-substituted assignments — no eval, so
# shell metacharacters in a value (e.g. the password) stay literal, never run.
CONN_YAML="$(neonctl connection-string "${BRANCH}" \
  --project-id="${NEON_PROJECT_ID}" \
  --role-name="${DB_PROD_USERNAME}" \
  --database-name="${DB_PROD_DBNAME}" \
  --extended --output=yaml)"

yaml_field() { awk -v k="$1" 'index($0, k": ") == 1 { print substr($0, length(k) + 3); exit }' <<<"${CONN_YAML}"; }

export DB_HOST="$(yaml_field host)"
export DB_USER="$(yaml_field role)"
export DB_PASS="$(yaml_field password)"
export DB_NAME="$(yaml_field database)"

# Install frontend assets
pushd assets
  yarn install
popd

mix phx.server
