#!/usr/bin/env bash
#MISE description="Install dependencies"
set -euo pipefail
[ -z "${DEBUG:-}" ] || set -x

if [[ "$(uname)" == "Linux" ]] && command -v apt-get &>/dev/null
then
  NEEDED_PKGS=(build-essential curl git libncurses-dev libssl-dev libreadline-dev zlib1g-dev uuid-dev inotify-tools)
  MISSING=()
  for pkg in "${NEEDED_PKGS[@]}"
  do
    dpkg -s "${pkg}" &>/dev/null \
    || MISSING+=("${pkg}")
  done
  if [[ ${#MISSING[@]} -gt 0 ]]
  then
    echo "📦 Installing Linux build dependencies: ${MISSING[*]}"
    sudo apt-get update
    sudo apt-get install -y "${MISSING[@]}"
  fi
fi

if ! command -v brew &>/dev/null
then
  echo "🍺 Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  echo "👆 You must follow NEXT STEPS above before continuing"
  exit 1
fi

for pkg in imagemagick gpg
do
  if ! brew list "${pkg}" &>/dev/null
  then
    echo "📦 Installing ${pkg}..."
    brew install "${pkg}"
  fi
done

if ! brew list icu4c &>/dev/null
then
  echo "📦 Installing icu4c..."
  brew install icu4c pkg-config
fi

if [[ "$(uname)" == "Linux" ]] && ! ldconfig -p | grep -q libicuuc.so.78
then
  echo "📦 Linking icu4c for Linux..."
  echo "$(brew --prefix icu4c)/lib" \
      | sudo tee /etc/ld.so.conf.d/homebrew-icu4c.conf > /dev/null
  sudo ldconfig
fi

echo "📦 Installing tools from mise.toml..."
mise install
