#!/usr/bin/env bash
#MISE description="Run app in dev mode with a Neon db branch"
#USAGE arg "<branch>" help="The Neon branch name to connect to"
set -euo pipefail

BRANCH="${usage_branch}"
NEON_PROJECT_ID="${NEON_PROJECT_ID:?must be set — configure fnox or set manually}"
DB_PROD_USERNAME="${DB_PROD_USERNAME:?must be set}"
DB_PROD_DBNAME="${DB_PROD_DBNAME:?must be set}"

# Get connection details and convert to env vars
eval "$(neonctl connection-string "${BRANCH}" \
    --project-id="${NEON_PROJECT_ID}" \
    --role-name="${DB_PROD_USERNAME}" \
    --database-name="${DB_PROD_DBNAME}" \
    --extended --output=yaml \
    | awk '
        /^host:/ {gsub(/^host: /, ""); print "export DB_HOST=" $0}
        /^role:/ {gsub(/^role: /, ""); print "export DB_USER=" $0}
        /^password:/ {gsub(/^password: /, ""); print "export DB_PASS=" $0}
        /^database:/ {gsub(/^database: /, ""); print "export DB_NAME=" $0}
    ')"

# Install frontend assets
cd assets && yarn install && cd ..

mix phx.server
