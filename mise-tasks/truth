#!/usr/bin/env bash
#MISE description="Save source files to destination (default: /truth)"
#USAGE arg "[dest]" help="Destination directory" default="/truth"
set -euo pipefail

dest="${usage_dest:-${1:-/truth}}"

rsync -av --delete \
  --exclude='.git/' \
  --filter=':- .gitignore' \
  ./ "${dest}/"

echo "Saved to ${dest}"
